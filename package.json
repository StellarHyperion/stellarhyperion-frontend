{
  "name": "@hyperion/app",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperion web app: the routing layer between Stellar and EVM, as an interface",
  "license": "MIT",
  "author": "dotmantissa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellarHyperion/stellarhyperion-frontend.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack --analyze && npm run bundle:check",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write \"**/*.{ts,tsx,mjs,css,json,md}\"",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,mjs,css,json,md}\"",
    "contrast": "node scripts/contrast.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "house": "node scripts/house-rules.mjs",
    "icons": "python3 scripts/render-icons.py",
    "test": "vitest run",
    "test:exact-amounts": "vitest run test/submission.test.ts test/assets.test.ts test/backend-api.test.ts test/wallet-signature.test.ts",
    "check": "npm run fmt:check && npm run house && npm run contrast && npm run test && npm run lint && npm run typecheck && npm run build",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:faults": "node scripts/browser-fault-harness.mjs",
    "test:browser:assistive": "node scripts/browser-assistive-audit.mjs",
    "test:browser:deployment": "node scripts/browser-deployment-revision.mjs",
    "test:browser:firefox": "HYPERION_BROWSER=firefox node scripts/browser-smoke.mjs",
    "test:browser:trace": "HYPERION_PROVIDER_DELAY_MS=75 node scripts/browser-performance-trace.mjs"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.12.0",
    "@creit.tech/xbull-wallet-connect": "^0.4.0",
    "@hyperion/protocol": "file:hyperion-protocol-0.1.0.tgz",
    "@lobstrco/signer-extension-api": "^3.0.0",
    "@stellar/freighter-api": "^6.0.0",
    "@stellar/stellar-sdk": "17.2.1",
    "lucide-react": "^1.49.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vite": "8.3.8"
  }
}
