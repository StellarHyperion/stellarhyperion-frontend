{
  "name": "@hyperion/app",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperion web app: the routing layer between Stellar and EVM, as an interface",
  "license": "MIT",
  "author": "dotmantissa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellarHyperion/stellarhyperion-frontend.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write \"**/*.{ts,tsx,mjs,css,json,md}\"",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,mjs,css,json,md}\"",
    "contrast": "node scripts/contrast.mjs",
    "house": "node scripts/house-rules.mjs",
    "icons": "python3 scripts/render-icons.py",
    "test": "vitest run",
    "check": "npm run fmt:check && npm run house && npm run contrast && npm run test && npm run lint && npm run typecheck && npm run build",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.12.0",
    "@creit.tech/xbull-wallet-connect": "^0.4.0",
    "@hyperion/protocol": "file:hyperion-protocol-0.1.0.tgz",
    "@lobstrco/signer-extension-api": "^2.0.0",
    "@stellar/freighter-api": "^6.0.0",
    "@stellar/stellar-sdk": "17.2.1",
    "lucide-react": "^1.49.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
