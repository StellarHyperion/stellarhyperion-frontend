# Hyperion web app configuration.
#
# Copy to .env.local and fill in. Nothing in here is a secret today, and nothing in here should
# ever become one: this file is the public half of the configuration and the app only reads
# NEXT_PUBLIC_* values, all of which end up in the browser bundle. If a value would hurt you in
# a view-source, it belongs in the backend, not here.

# Which side of the fence to talk to. "testnet" or "mainnet".
NEXT_PUBLIC_HYPERION_NETWORK=testnet

# The status indexer described in section 11 of the architecture plan. Not called yet.
NEXT_PUBLIC_HYPERION_INDEXER_URL=http://localhost:4000

# Override the chain registry's default public RPC endpoints when you have your own.
# Leave blank to use the defaults that ship in @hyperion/protocol.
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_EVM_RPC_URL=

# WalletConnect project id, for the EVM leg. Public by design, rate limited per project.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
