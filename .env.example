# Public browser configuration only. Never put signing keys here.
# Testnet is the only supported network.

# Optional indexer: needed for history and verified destination delivery.
# Leave unset to show history as unavailable.
# NEXT_PUBLIC_HYPERION_API_URL=http://localhost:8080

# Optional overrides. Omit these to use src/config/testnet-deployment.json.
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_STELLAR_ROUTER=
# NEXT_PUBLIC_STELLAR_USDC=
